<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Comma-separated Windows service names (the short name, not the display name). -->
    <add key="ServicesToWatch" value="Spooler,W3SVC" />

    <!-- How often to check, in seconds (minimum 5). -->
    <add key="PollIntervalSeconds" value="30" />

    <!-- Alert if a watched service is already stopped when the monitor starts. -->
    <add key="AlertOnStartupIfStopped" value="true" />

    <!-- Also send a notification when a stopped service starts again. -->
    <add key="AlertOnRecovery" value="false" />

    <!-- Email notifications. Set SendEmail to false to only log to console and ServiceMonitor.log. -->
    <add key="SendEmail" value="true" />
    <add key="SmtpHost" value="smtp.example.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUseSsl" value="true" />
    <add key="SmtpUser" value="alerts@example.com" />
    <add key="SmtpPassword" value="your-password-here" />
    <add key="EmailFrom" value="alerts@example.com" />
    <!-- Comma-separated recipients. -->
    <add key="EmailTo" value="admin@example.com" />
    <add key="SubjectPrefix" value="[ServiceMonitor] " />
  </appSettings>
</configuration>
